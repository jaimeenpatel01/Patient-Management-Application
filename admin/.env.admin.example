# Copy to admin/.env.admin (git-ignored) and fill in.
# Supabase Dashboard → Project Settings → API (or `npx supabase status` for the local stack).
SUPABASE_URL=
# The service_role / secret key. It bypasses Row-Level Security: never commit it, share it, or put it in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to 4500
# ADMIN_PORT=4500
