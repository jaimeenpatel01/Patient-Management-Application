# Copy to admin/.env.admin (dev, `npm run admin:dev`) and/or admin/.env.admin.prod
# (production, `npm run admin:prod`). Both are git-ignored.
# Supabase Dashboard → Project Settings → API (or `npx supabase status` for the local stack).
SUPABASE_URL=
# The service_role / secret key. It bypasses Row-Level Security: never commit it, share it, or put it in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to 4500 for a local database and 4501 for production.
# ADMIN_PORT=4500
